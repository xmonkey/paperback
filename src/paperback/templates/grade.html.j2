{% extends "base.html.j2" %}
{% block title %}批改 · {{ session.deck }}{% endblock %}
{% block head %}
<style>
  .grade-card{border:1px solid #cbd5e1;border-radius:10px;padding:20px;margin-bottom:12px;max-height:60vh;overflow-y:auto}
  .grade-btns{display:flex;gap:10px;margin-top:16px}
  .grade-btns button{flex:1;padding:14px;font-size:16px;border-radius:8px;border:2px solid;text-align:center}
  .gb-1{border-color:#ef4444;color:#991b1b} .gb-1:hover{background:#fee2e2}
  .gb-2{border-color:#f59e0b;color:#92400e} .gb-2:hover{background:#fef3c7}
  .gb-3{border-color:#10b981;color:#065f46} .gb-3:hover{background:#d1fae5}
  .gb-4{border-color:#3b82f6;color:#1e40af} .gb-4:hover{background:#dbeafe}
  .grade-btns button:disabled{opacity:.5;cursor:wait}
  .progress-bar{height:8px;background:#e2e8f0;border-radius:4px;overflow:hidden;margin-bottom:8px}
  .progress-bar>div{height:100%;background:#10b981;transition:width .3s}
  .badge-pending{background:#f59e0b;color:#7c2d12;padding:2px 8px;border-radius:6px;font-size:12px}
</style>
{% endblock %}
{% block body %}
<div class="nav">
  <a href="/session/{{ session.id }}">← 返回</a>
  <strong>{{ session.deck }}</strong>
</div>

{% if mismatched %}
<div class="alert error">
  ⚠ 检测到 Anki 当前状态与生成此默写卷时不一致，已阻止批改（防止写错 profile）：
  <ul>
    {% for m in mismatched %}<li>卡片 #{{ m.card_id }}：{{ m.reason }}</li>{% endfor %}
  </ul>
  请在 Anki 中切回对应 profile / 确认 deck，然后刷新此页；或<a href="/">重新生成默写卷</a>。
</div>

{% elif cards_json == "[]" %}
<div class="alert info">🎉 全部已批改完成。<br><a href="/session/{{ session.id }}">返回概览</a></div>

{% else %}
<div id="grade-app">
  <div class="row" style="margin-bottom:8px">
    <span id="counter">1 / {{ cards_json|length }}</span>
    <span id="pending-badge" style="display:none" class="badge-pending">⚠ <span id="pending-n">0</span> 张待补交</span>
    <button class="no-print" style="margin-left:auto" onclick="location='/session/{{ session.id }}'">暂停退出</button>
  </div>
  <div class="progress-bar"><div id="pbar" style="width:0%"></div></div>

  <div class="grade-card">
    <div class="card-content" id="front"></div>
    <div id="answer-wrap" style="display:none;margin-top:16px;border-top:1px solid #e2e8f0;padding-top:12px">
      <div class="muted small" style="margin-bottom:4px">答案</div>
      <div class="card-content" id="back"></div>
    </div>
  </div>

  <div class="grade-btns">
    <button class="gb-1" onclick="answer(1)">1 重来<small><br>again</small></button>
    <button class="gb-2" onclick="answer(2)">2 困难<small><br>hard</small></button>
    <button class="gb-3" onclick="answer(3)">3 记得<small><br>good</small></button>
    <button class="gb-4" onclick="answer(4)">4 轻松<small><br>easy</small></button>
  </div>
  <p class="muted small" style="margin-top:8px">
    <kbd>Space</kbd> 显示答案 · <kbd>1</kbd>~<kbd>4</kbd> 评分 · <kbd>Enter</kbd> 默认 <strong>1 重来</strong>
  </p>
</div>

<div id="done" style="display:none" class="alert info">
  🎉 批改完成！<br><div id="done-stats" style="margin-top:6px"></div>
  <br><a class="btn" href="/session/{{ session.id }}">返回概览</a>
</div>

<script>
const CARDS = {{ cards_json | safe }};
const SID = "{{ session.id }}";
let idx = 0, revealed = false, pending = 0;
const stats = {1:0,2:0,3:0,4:0};

function render(){
  if(idx >= CARDS.length){ finish(); return; }
  const c = CARDS[idx];
  document.getElementById('counter').textContent = (idx+1)+' / '+CARDS.length;
  document.getElementById('pbar').style.width = (idx/CARDS.length*100)+'%';
  document.getElementById('front').innerHTML = c.front;
  document.getElementById('back').innerHTML = c.back;
  document.getElementById('answer-wrap').style.display = 'none';
  revealed = false;
  document.querySelector('.grade-card').scrollTop = 0;
  window.scrollTo(0,0);
}
function reveal(){
  if(revealed) return;
  document.getElementById('answer-wrap').style.display = 'block';
  revealed = true;
}
async function answer(ease){
  if(!revealed) return;
  const c = CARDS[idx];
  document.querySelectorAll('.grade-btns button').forEach(b=>b.disabled=true);
  try{
    const r = await fetch(`/api/session/${SID}/grade/${c.card_id}`,{
      method:'POST',headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ease})
    });
    const d = await r.json();
    stats[ease]++;
    if(d.progress && d.progress.pending){ pending = d.progress.pending; showPending(); }
    if(!d.ok && d.reason==='invalid'){ alert('卡片 #'+c.card_id+' 已在 Anki 中失效，已跳过'); }
    idx++; render();
  }catch(e){ alert('提交失败：'+e); }
  finally{ document.querySelectorAll('.grade-btns button').forEach(b=>b.disabled=false); }
}
function showPending(){
  document.getElementById('pending-badge').style.display='inline-block';
  document.getElementById('pending-n').textContent=pending;
}
function finish(){
  document.getElementById('grade-app').style.display='none';
  document.getElementById('done').style.display='block';
  document.getElementById('done-stats').innerHTML =
    `重来 ${stats[1]} · 困难 ${stats[2]} · 记得 ${stats[3]} · 轻松 ${stats[4]}`;
}
document.addEventListener('keydown', e=>{
  if(e.target.tagName==='INPUT'||e.target.tagName==='TEXTAREA') return;
  if(e.code==='Space'){ e.preventDefault(); reveal(); }
  else if(revealed){
    if(e.key==='1') answer(1);
    else if(e.key==='2') answer(2);
    else if(e.key==='3') answer(3);
    else if(e.key==='4') answer(4);
    else if(e.key==='Enter') answer(1);
  }
});
render();
</script>
{% endif %}
{% endblock %}
