{% extends "base.html.j2" %}
{% block title %}答案卷 · {{ session.deck }} · {{ session.id }}{% endblock %}
{% block body %}
<div class="no-print nav">
  <a href="/session/{{ session.id }}">← 返回</a>
  <strong>答案卷 · {{ session.deck }}</strong>
  <span class="muted">{{ cards|length }} 张</span>
  <button onclick="window.print()">🖨 打印此页</button>
</div>

{% include "_layout_controls.html.j2" %}

<div class="print-only sheet-header">
  <strong>答案卷 · {{ session.deck }}</strong> · {{ session.id }} · {{ cards|length }} 张
</div>

<div class="sheet">
{% for c in cards %}
  {% set is_long = (c.front|length > 500) or (c.back|length > 500) %}
  <div class="card {{ 'long' if is_long }}">
    <div class="idx">#{{ "%03d"|format(loop.index) }}</div>
    <div class="front card-content">{{ c.front|safe }}</div>
    <div class="back card-content">{{ c.back|safe }}</div>
  </div>
{% endfor %}
</div>
{% endblock %}
