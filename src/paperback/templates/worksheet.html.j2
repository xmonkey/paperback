{% extends "base.html.j2" %}
{% block title %}默写卷 · {{ session.deck }} · {{ session.id }}{% endblock %}
{% block head %}
<style>
  :root{--pb-font-scale:1;--pb-cols:1}
  .layout-controls{display:flex;gap:14px;align-items:center;flex-wrap:wrap;margin:12px 0;padding:10px 14px;background:#f1f5f9;border-radius:8px;font-size:14px}
  .layout-controls label{display:flex;align-items:center;gap:4px}
  .layout-controls select{padding:4px 8px;border:1px solid #cbd5e1;border-radius:4px;font:inherit}
  .sheet{font-size:calc(15px * var(--pb-font-scale, 1));display:grid;grid-template-columns:repeat(var(--pb-cols,1),1fr);gap:12px}
  .sheet .card{margin-bottom:0}
</style>
<style id="pb-page-style">@page{size:A4 portrait;margin:14mm}</style>
{% endblock %}
{% block body %}
<div class="no-print nav">
  <a href="/session/{{ session.id }}">← 返回</a>
  <strong>{{ session.deck }}</strong>
  <span class="muted">{{ cards|length }} 张</span>
  <button onclick="window.print()">🖨 打印此页</button>
</div>

<div class="no-print layout-controls">
  排版：
  <label>字号 <select id="lc-font"><option value="0.85">紧凑</option><option value="1">标准</option><option value="1.15">宽松</option></select></label>
  <label>方向 <select id="lc-orient"><option value="portrait">纵向</option><option value="landscape">横向</option></select></label>
  <label>列数 <select id="lc-cols"><option value="1">单列</option><option value="2">双列</option></select></label>
</div>

<div class="print-only sheet-header">
  <strong>{{ session.deck }}</strong> · {{ session.id }} · {{ cards|length }} 张
</div>

<div class="sheet">
{% for c in cards %}
  {% set is_long = (c.front|length > 500) or (c.back|length > 500)
       or ('<img' in c.front|lower) or ('<img' in c.back|lower) %}
  <div class="card {{ 'long' if is_long }}">
    <div class="idx">#{{ "%03d"|format(loop.index) }}</div>
    <div class="front card-content">{{ c.front|safe }}
      {% if is_long %}<span class="long-badge">长卡·可另附纸</span>{% endif %}
    </div>
    <div class="blank"><div class="line"></div></div>
  </div>
{% endfor %}
</div>

<script>
(function(){
  const root = document.documentElement;
  const DECK = encodeURIComponent({{ session.deck | tojson }});
  const KEYS = {
    font:`pb_layout_${DECK}_font`,
    orient:`pb_layout_${DECK}_orient`,
    cols:`pb_layout_${DECK}_cols`,
  };
  const pageStyle = document.getElementById('pb-page-style');

  function apply(){
    const font = document.getElementById('lc-font').value;
    const orient = document.getElementById('lc-orient').value;
    const cols = document.getElementById('lc-cols').value;
    root.style.setProperty('--pb-font-scale', font);
    root.style.setProperty('--pb-cols', cols);
    pageStyle.textContent = '@page{size:A4 ' + orient + ';margin:14mm}';
    localStorage.setItem(KEYS.font, font);
    localStorage.setItem(KEYS.orient, orient);
    localStorage.setItem(KEYS.cols, cols);
  }

  // 恢复上次设置（按 deck）
  Object.entries(KEYS).forEach(([k, sk]) => {
    const v = localStorage.getItem(sk);
    if (v !== null) {
      const sel = document.getElementById('lc-' + k);
      if (sel) sel.value = v;
    }
  });
  apply();
  document.querySelectorAll('.layout-controls select').forEach(s => s.addEventListener('change', apply));
})();
</script>
{% endblock %}
