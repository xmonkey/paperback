{% extends "base.html.j2" %}
{% block title %}Paperback · 选择 Deck{% endblock %}
{% block body %}
<h1>Paperback</h1>
<p class="muted">Anki 默写工具 · 生成今日到期卡片的默写卷</p>
<p class="small"><a href="/settings">⚙ OCR 设置</a></p>

{% if not data_dir_ok %}
<div class="alert error">⚠ 数据目录不可写：{{ data_dir_err }}<br>请检查权限或设置环境变量 <code>PAPERBACK_DATA_DIR</code></div>
{% endif %}

{% if anki_error %}
<div class="alert error">⚠ 无法连接 AnkiConnect（{{ anki_error }}）。请确认 Anki 桌面版正在运行，并已安装 AnkiConnect 插件。</div>
{% elif error == 'no_due' %}
<div class="alert info">📭 deck「{{ error_deck }}」今日无到期卡片。可以选其他 deck，或明天再来。</div>
{% elif error == 'no_match' %}
<div class="alert warn">⚠ deck「{{ error_deck }}」今日有到期卡片，但按当前方向筛选后没有可默写的卡。试试把「方向」改为「全部」。</div>
{% endif %}

<h2>选择 Deck</h2>
{% if decks %}
<form method="post" action="/generate">
  <div class="row">
    <select name="deck" id="deck">
      {% for d in decks %}
      <option value="{{ d }}" {% if d == error_deck %}selected{% endif %}>{{ d }}</option>
      {% endfor %}
    </select>
    <label><input type="checkbox" name="filter_cjk" checked> 过滤默写卡片（只默写英文单词/词组，排除背面是中文释义的卡）</label>
    <label>数量 <input type="number" name="limit" value="20" min="1" max="100" style="width:80px"></label>
    <button type="submit">生成默写卷</button>
  </div>
</form>
<p class="muted small">支持任意卡片类型（直接用 Anki 渲染的正反面）。勾选「过滤」= 排除背面是中文释义的卡（默认开启）。</p>
{% elif not anki_error %}
<p class="muted">Anki 中没有 deck。</p>
{% endif %}

<h2>历史 session</h2>
{% if sessions %}
<table style="width:100%;border-collapse:collapse">
  <thead><tr style="text-align:left;border-bottom:1px solid #cbd5e1"><th>时间</th><th>Deck</th><th>进度</th><th></th></tr></thead>
  <tbody>
  {% for s in sessions %}
  <tr style="border-bottom:1px solid #e2e8f0">
    <td style="padding:6px 8px 6px 0">{{ s.id }}</td>
    <td>{{ s.deck }}</td>
    <td>{{ s.graded }}/{{ s.total }}{% if s.pending %} <span style="color:#b45309">⚠{{ s.pending }} 待补</span>{% endif %}</td>
    <td style="text-align:right">
      <a class="btn" href="/session/{{ s.id }}">查看</a>
      {% if s.graded < s.total %}<a class="btn" href="/session/{{ s.id }}/grade">继续批改</a>{% endif %}
    </td>
  </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<p class="muted">暂无历史 session</p>
{% endif %}
{% endblock %}
