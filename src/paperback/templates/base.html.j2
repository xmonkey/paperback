<!doctype html>
<html lang="zh">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% block title %}Paperback{% endblock %}</title>
<style>
  *{box-sizing:border-box}
  body{font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;line-height:1.6;color:#222;max-width:900px;margin:0 auto;padding:24px}
  h1,h2,h3{line-height:1.3}
  h1{margin:0 0 4px}
  a{color:#2563eb}
  button,.btn{font:inherit;cursor:pointer;padding:8px 16px;border:1px solid #cbd5e1;border-radius:6px;background:#fff;text-decoration:none;display:inline-block;color:#222}
  button:hover,.btn:hover{background:#f1f5f9}
  input,select{font:inherit;padding:6px 10px;border:1px solid #cbd5e1;border-radius:6px}
  code{background:#f1f5f9;padding:1px 5px;border-radius:4px;font-size:.9em}
  kbd{background:#f1f5f9;border:1px solid #cbd5e1;border-bottom-width:2px;border-radius:4px;padding:1px 6px;font-size:.85em;font-family:monospace}
  .nav{display:flex;gap:12px;margin-bottom:16px;align-items:center;flex-wrap:wrap}
  .muted{color:#64748b} .small{font-size:13px}
  .row{display:flex;gap:12px;align-items:center;flex-wrap:wrap}

  /* anki 卡片内容 */
  .card-content img{max-width:100%;height:auto}
  .card-content{overflow-wrap:break-word;word-break:break-word}
  .card-content pre,.card-content table{max-width:100%;overflow-x:auto;display:block}

  /* cloze */
  .cloze-blank{display:inline-block;min-width:6em;border-bottom:2px solid currentColor;vertical-align:bottom;height:1.1em}
  .cloze-hint{color:#888;font-style:italic;margin-right:4px}
  .cloze-answer{background:#fff3a0;padding:0 4px;border-radius:3px;font-weight:600;border:1px solid #d4ab00}

  /* alert */
  .alert{padding:12px 16px;border-radius:8px;margin:12px 0}
  .alert.warn{background:#fef3c7;border:1px solid #f59e0b}
  .alert.error{background:#fee2e2;border:1px solid #ef4444}
  .alert.info{background:#dbeafe;border:1px solid #3b82f6}

  /* sheet（默写卷/答案卷） */
  .sheet .card{display:flex;border:1px solid #cbd5e1;border-radius:8px;margin-bottom:12px;overflow:hidden;page-break-inside:avoid}
  .sheet .card.long{page-break-inside:auto}
  .sheet .card .idx{flex:0 0 56px;background:#f1f5f9;display:flex;align-items:flex-start;justify-content:center;padding:8px;font-weight:700;font-size:14px;color:#475569;border-right:1px solid #cbd5e1}
  .sheet .card .front{flex:0 0 56%;padding:12px 14px}
  .sheet .card .blank{flex:1;padding:12px 14px;border-left:1px dashed #cbd5e1}
  .sheet .card .blank .line{border-bottom:1px solid #94a3b8;height:2.2em}
  .sheet .card .back{flex:1;padding:12px 14px;border-left:1px dashed #cbd5e1}
  .long-badge{display:inline-block;font-size:11px;background:#fbbf24;color:#7c2d12;padding:1px 6px;border-radius:4px;margin-left:6px}

  .print-only{display:none}
  @media print{
    @page{size:A4;margin:14mm}
    .no-print{display:none!important}
    .print-only{display:block}
    .sheet-header{margin-bottom:12px;border-bottom:1px solid #999;padding-bottom:4px;font-size:12px;color:#475569}
    body{max-width:none;padding:0}
    .sheet .card{page-break-inside:avoid}
    .sheet .card.long{page-break-inside:auto}
  }
</style>
{% block head %}{% endblock %}
</head>
<body>
{% block body %}{% endblock %}
</body>
</html>
